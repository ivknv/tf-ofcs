                "maxval": 60.0
            },
            "optical_fiber__chromatic_dispersion": {"type": "uniform", "minval": 0.0, "maxval": 20.0, "dtype": "float32"}
        }
    },
    "optimizer_parameters": {"learning_rate": 0.0001}
}
