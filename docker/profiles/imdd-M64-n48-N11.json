{
    "model_type": "IMDDAutoencoder",
    "model_path": "imdd-M64-n48-N11.keras",
    "batch_size": 4096,
    "epochs": 100,
    "model_parameters": {
        "M": 64,
        "n": 48,
        "N": 11,
        "transmission_layer_parameters": {
            "optical_fiber__length": [40.0],
